[Unit]
Description=Verified external snapshot of isolated Donchian observer
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=donchianbackup
Group=donchian
WorkingDirectory=/opt/donchian-observer
Environment=PYTHONPATH=/opt/donchian-observer
Environment=HOME=/nonexistent
Environment=TZ=UTC
UMask=0027
ExecStart=/usr/bin/python3 -B -m research.donchian_external_backup
TimeoutStartSec=180
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=-/var/lib/tradingbot
ReadOnlyPaths=/var/lib/donchian-observer
ReadWritePaths=/var/lib/donchian-backup
MemoryMax=80M
CPUQuota=15%
TasksMax=16
Nice=15
LogRateLimitIntervalSec=1min
LogRateLimitBurst=10
