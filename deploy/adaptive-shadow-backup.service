[Unit]
Description=Verified external snapshot of adaptive research shadow
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=adaptiveobserver
Group=adaptiveobserver
Environment=HOME=/nonexistent
Environment=TZ=UTC
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/adaptive-shadow-backup/adaptive_external_backup.py
TimeoutStartSec=180
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=-/var/lib/tradingbot -/var/lib/donchian-observer -/var/lib/donchian-control -/var/lib/donchian-backup
ReadOnlyPaths=/var/lib/adaptive-shadow
ReadWritePaths=/var/lib/adaptive-shadow-external
MemoryMax=80M
CPUQuota=15%
TasksMax=12
Nice=15
LogRateLimitIntervalSec=1min
LogRateLimitBurst=10
