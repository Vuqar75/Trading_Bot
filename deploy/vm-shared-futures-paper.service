[Unit]
Description=Futures paper with shared financial journal
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tradingbot
Group=tradingbot
WorkingDirectory=/opt/trading-bot-wallet
Environment=HOME=/var/lib/tradingbot
Environment=UNIFIED_PAPER_QUEUE=/var/lib/tradingbot/Trading_Bot_paper_state/unified-commands.db
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tradingbot
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
ExecStart=/usr/bin/python3 -B -m trading_bot.futures_app --db /var/lib/tradingbot/paper-financial/shared-paper.db --margin 10 --fee-bps 5 --slippage-bps 2 --maintenance-bps 50 --allow-paper-signal --shared-paper

[Install]
WantedBy=multi-user.target
