# Use a separate Telegram bot for this runtime. Never reuse a polling token
# already used by another running process. Replace locally; never commit secrets.
RUNTIME_TELEGRAM_BOT_TOKEN=
RUNTIME_TELEGRAM_OWNER_ID=
# Only for explicit Spot Testnet mode; never production credentials:
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
