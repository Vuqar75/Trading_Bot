[Unit]
Description=Spot paper monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tradingbot
Group=tradingbot
WorkingDirectory=/opt/trading-bot-paper
Environment=HOME=/var/lib/tradingbot
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tradingbot
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
ExecStart=/usr/bin/python3 -B -m trading_bot.paper_monitor --db /var/lib/tradingbot/Trading_Bot_paper_state/runtime-paper.db --state-dir /var/lib/tradingbot/Trading_Bot_paper_state/monitor

[Install]
WantedBy=multi-user.target
