[Unit]
Description=Encrypted verified backup of AI research budget
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/tradingbot-ai-regular
Environment=PYTHONPATH=/opt/tradingbot-ai-regular
Environment=TZ=UTC
ExecStart=/usr/bin/python3 -B -m research.adaptive_regular_backup
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=-/var/lib/tradingbot -/var/lib/donchian-observer -/var/lib/adaptive-shadow
ReadWritePaths=/var/lib/tradingbot-ai-executor /var/lib/tradingbot-ai-budget-backup
MemoryMax=96M
CPUQuota=15%
TasksMax=12
Nice=15
LogRateLimitIntervalSec=1min
LogRateLimitBurst=5
