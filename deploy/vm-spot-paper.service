[Unit]
Description=Spot paper
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tradingbot
Group=tradingbot
WorkingDirectory=/opt/trading-bot-paper
Environment=HOME=/var/lib/tradingbot
Environment=FUTURES_OUTBOX_DB=/var/lib/tradingbot/Trading_Bot_futures_state/futures-paper.db
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tradingbot
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
ExecStart=/usr/bin/python3 -B deploy/cloud_paper_launch.py

[Install]
WantedBy=multi-user.target
