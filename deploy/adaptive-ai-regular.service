[Unit]
Description=Budget-limited adaptive AI shadow
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/tradingbot-ai-regular/authorization.json

[Service]
Type=oneshot
User=adaptiveai
Group=adaptiveai
WorkingDirectory=/opt/tradingbot-ai-regular
Environment=PYTHONPATH=/opt/tradingbot-ai-regular
Environment=TZ=UTC
LoadCredentialEncrypted=TRADING_BOT_AI:/etc/credstore.encrypted/tradingbot-ai.cred
ExecStart=/usr/bin/python3 -B -m research.adaptive_regular
TimeoutStartSec=110
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=169.254.169.254
InaccessiblePaths=-/var/lib/tradingbot -/var/lib/donchian-observer -/var/lib/adaptive-shadow
ReadWritePaths=/var/lib/tradingbot-ai-executor /var/lib/tradingbot-ai-executor-public
MemoryMax=96M
CPUQuota=15%
TasksMax=12
Nice=15
LogRateLimitIntervalSec=1min
LogRateLimitBurst=5
