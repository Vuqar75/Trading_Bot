[Unit]
Description=Publish validated AI server result to existing Telegram read-only view
ConditionPathExists=/var/lib/tradingbot-ai-executor-public/report.json

[Service]
Type=oneshot
WorkingDirectory=/opt/tradingbot-ai-executor
Environment=PYTHONPATH=/opt/tradingbot-ai-executor
ExecStart=/usr/bin/python3 -B -m research.adaptive_server_publish
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/tradingbot-ai-public
ReadOnlyPaths=/var/lib/tradingbot-ai-executor-public
InaccessiblePaths=-/var/lib/tradingbot-ai-executor -/etc/credstore.encrypted -/var/lib/tradingbot/paper-financial
MemoryMax=64M
TasksMax=8

