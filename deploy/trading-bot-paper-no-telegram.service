[Unit]
Description=BTCUSDT Spot paper runtime without Telegram (starts paused)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=tradingbot
Group=tradingbot
WorkingDirectory=/opt/trading-bot
ExecStart=/usr/bin/python3 -B -m trading_bot.app --mode paper --db /var/lib/trading-bot-runtime/runtime-paper.db --interval 15m
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
StateDirectory=trading-bot-runtime
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
